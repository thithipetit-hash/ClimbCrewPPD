# =============================================================================
# Image de production du frontend pour le serveur Linux
# =============================================================================
# Render construit directement le site statique avec render.yaml. Ce fichier
# reste utilisé par Docker Compose sur Linux et produit le même bundle Vite.
# Le contexte Docker est la racine du dépôt afin que VERSION reste l'unique
# source du numéro applicatif pendant la compilation conteneurisée.

# Étape 1 : compilation React/Vite dans une image Node temporaire.
FROM node:24-alpine AS build

WORKDIR /app/frontend

# L'URL /api est volontairement relative sur Linux : le reverse proxy public et
# Nginx servent le frontend et l'API sous le même domaine.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

# Le SHA du commit validé est injecté explicitement par le workflow de
# déploiement. Le contexte Docker ne contient volontairement pas .git, donc le
# script de génération du marqueur ne peut pas le découvrir tout seul.
ARG GITHUB_SHA=unknown
ENV GITHUB_SHA=${GITHUB_SHA}

# Le build de production utilise exactement le même lockfile que la CI.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund --registry=https://registry.npmjs.org/

# Copie le frontend, la version et les modules métier partagés nécessaires au
# bundle. Le frontend dépend désormais directement de /shared et n'embarque plus
# l'adaptateur de compatibilité backend.
COPY frontend/ ./
COPY VERSION /app/VERSION
COPY shared/ /app/shared/

# Génère les fichiers HTML, CSS et JavaScript optimisés dans /app/frontend/dist.
RUN npm run build

# Étape 2 : serveur web léger qui ne conserve aucun outil de compilation.
FROM nginx:1.27-alpine

# Configuration Nginx : sécurité, route React et relais de secours vers /api.
COPY frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copie uniquement le résultat final du build dans le répertoire public Nginx.
COPY --from=build /app/frontend/dist /usr/share/nginx/html

# Port interne du conteneur frontend. Le reverse proxy Linux publie ensuite le
# service en HTTPS ; Nginx ne gère pas directement les certificats.
EXPOSE 80
