# ClimbCrew - exemple de configuration production Linux
# Copier ce fichier en .env.production sur le serveur.
# Ne jamais committer le fichier .env.production réel.

# Domaine public exposé par le reverse proxy HTTPS.
PUBLIC_URL=https://climbcrew.dip-tcs.com
FRONTEND_ORIGIN=https://climbcrew.dip-tcs.com
CORS_ORIGIN=https://climbcrew.dip-tcs.com

# Mode applicatif.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1

# Cookies : HTTPS est terminé par le reverse proxy.
SECURE_COOKIES=true
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=climbcrew_session
CSRF_COOKIE_NAME=climbcrew_csrf
SESSION_DURATION_DAYS=7

# PostgreSQL Docker.
POSTGRES_DB=climbcrew
POSTGRES_USER=climbcrew
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://climbcrew:CHANGE_ME_LONG_RANDOM_PASSWORD@db:5432/climbcrew
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# Maintenance / initialisation.
SETUP_TOKEN=CHANGE_ME_LONG_RANDOM_SETUP_TOKEN

# Politique de création de compte.
# Après vérification e-mail, le compte reste en attente : un administrateur doit
# l'associer à une fiche grimpeur puis l'approuver dans Gestion des comptes.

# Premier administrateur.
# N'activer ALLOW_FIRST_ADMIN_BOOTSTRAP que pour le tout premier démarrage
# d'une installation neuve, puis le remettre immédiatement à false.
ALLOW_FIRST_ADMIN_BOOTSTRAP=false
FIRST_ADMIN_EMAIL=admin@example.invalid
FIRST_ADMIN_PASSWORD=CHANGE_ME_StrongPassword_2026!
ALLOW_WEAK_FIRST_ADMIN_PASSWORD=false
BCRYPT_ROUNDS=12

# Messagerie transactionnelle SMTP.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=climbcrew@example.invalid
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM_NAME=CristalClimbClub
EMAIL_FROM_ADDRESS=climbcrew@example.invalid
EMAIL_REPLY_TO=club@example.invalid
# Destinataires techniques optionnels, séparés par des virgules.
ACCOUNT_REQUEST_NOTIFICATION_RECIPIENTS=
RESET_TOKEN_DURATION_MINUTES=60

# Rétention des données techniques d'authentification.
# Un lien de confirmation de compte est valable 7 jours : le compte pending
# non vérifié est supprimé le lendemain de son expiration par défaut.
UNVERIFIED_ACCOUNT_RETENTION_DAYS=8
# Les jetons déjà utilisés ou expirés sont conservés encore quelques jours pour
# le diagnostic, puis supprimés automatiquement.
SECURITY_TOKEN_RETENTION_DAYS=7
# Les lignes de sessions révoquées ou expirées sont supprimées après ce délai.
SESSION_RECORD_RETENTION_DAYS=30

# Sauvegardes PostgreSQL du serveur Linux.
BACKUP_ENABLED=true
BACKUP_TIMEZONE=Europe/Paris
BACKUP_HOUR=3
BACKUP_RECIPIENT=backup@example.invalid
BACKUP_RETENTION_DAYS=35
BACKUP_UPLOAD_MAX_BYTES=52428800
# Clé dédiée de 32 octets pour chiffrer toute sauvegarde jointe à un e-mail.
# Génération recommandée : openssl rand -base64 32
# Conserver la clé hors de la boîte mail qui reçoit les sauvegardes.
BACKUP_EMAIL_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_RANDOM_KEY_BASE64

# Frontend Vite.
VITE_API_URL=/api

# Limites applicatives et conservation des journaux techniques.
# Le garde-fou PRE_BODY est exécuté avant express.json().
PRE_BODY_RATE_LIMIT_PER_MINUTE=30
PRE_BODY_MAX_TRACKED_CLIENTS=4096
PUBLIC_AUTH_MAX_BODY_BYTES=65536
GENERAL_JSON_MAX_BODY_BYTES=2097152
# La limite globale historique reste utilisée par l'import administrateur complet.
MAX_JSON_BODY_SIZE=10mb
WRITE_RATE_LIMIT_PER_MINUTE=120
ACCESS_LOG_RETENTION_DAYS=90
