# =============================================================================
# Image de production du backend pour le serveur Linux
# =============================================================================
# Render utilise le runtime Node défini dans render.yaml. Ce Dockerfile reste
# dédié au déploiement Docker Compose sur Linux et conserve donc son comportement.

# Node 24 correspond à la version utilisée pour construire et exécuter l'API.
FROM node:24-alpine

# Active les réglages de sécurité du code Node : cookies sécurisés, coût bcrypt
# renforcé et absence des facilités réservées au développement.
ENV NODE_ENV=production

# pg_dump, pg_restore et psql servent aux sauvegardes PostgreSQL complètes et à
# leur restauration depuis l'administration. La version est explicitement fixée
# à 16 pour correspondre à l'image postgres:16-alpine du service "db" : un
# pg_dump/pg_restore plus récent (17+) émet des réglages de session (ex.
# "transaction_timeout") que le serveur 16 ne reconnaît pas, ce qui fait
# échouer toute restauration, y compris le filet de sécurité pre-restore.
RUN apk add --no-cache postgresql16-client

# Tous les chemins suivants sont relatifs au répertoire applicatif du conteneur.
WORKDIR /app

# Reproduction exacte des dépendances validées en CI grâce au lockfile.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund --registry=https://registry.npmjs.org/

# Copie du code du backend après l'installation des dépendances.
COPY . .

# Exécution avec l'utilisateur non-root fourni par l'image Node.
# Impact visuel : aucun ; cette mesure limite les conséquences d'une faille API.
USER node

# Port interne utilisé par Docker Compose. Le reverse proxy Linux reste le seul
# composant exposé publiquement et relaie /api vers ce port.
EXPOSE 3000

# Lance le même script npm que le runtime Render afin de garder un point d'entrée
# identique entre les deux plateformes.
CMD ["npm", "start"]
